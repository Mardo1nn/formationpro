<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formation Business Digital</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect fill='%23C9A24B' width='100' height='100' rx='20'/><text x='50' y='70' font-size='60' text-anchor='middle' fill='white' font-family='serif' font-weight='bold'>F</text></svg>">
<link href="https://cdn.jsdelivr.net/fontsource/fonts/plus-jakarta-sans@latest/latin-400-normal.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/fontsource/fonts/plus-jakarta-sans@latest/latin-600-normal.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/fontsource/fonts/plus-jakarta-sans@latest/latin-700-normal.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/fontsource/fonts/playfair-display@latest/latin-700-normal.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{--cream:#FBF7F0;--cream-2:#F5EFE3;--gold:#C9A24B;--gold-2:#B8892F;--gold-light:#E8D5A0;--gold-soft:#F3E7C4;--white:#FFF;--ink:#1C1A16;--ink-2:#3A3630;--muted:#6B6458;--line:#E8DFC9;--wa:#25D366;--shadow:0 10px 30px rgba(60,45,10,.08);--shadow-lg:0 20px 60px rgba(60,45,10,.12);--radius:16px;--radius-lg:24px;--grad-gold:linear-gradient(135deg,#E8D5A0 0%,#C9A24B 50%,#B8892F 100%);--grad-cream:linear-gradient(135deg,#FBF7F0 0%,#F5EFE3 100%)}
*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:var(--cream);color:var(--ink);line-height:1.6;overflow-x:hidden;min-height:100vh}
h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:700;line-height:1.2;color:var(--ink)}
h1{font-size:clamp(2rem,5vw,3.8rem)}h2{font-size:clamp(1.8rem,4vw,2.8rem)}h3{font-size:clamp(1.3rem,2.5vw,1.6rem)}
p{color:var(--ink-2)}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
button{font-family:inherit;cursor:pointer;border:none;background:none}
.container{max-width:1280px;margin:0 auto;padding:0 24px}section{padding:80px 0;position:relative}
@media(max-width:768px){section{padding:60px 0}}
.topbar{background:var(--ink);color:var(--gold-light);overflow:hidden;padding:10px 0;font-size:13px;letter-spacing:2px;font-weight:500}
.topbar-track{display:flex;gap:60px;white-space:nowrap;animation:scroll 35s linear infinite;width:max-content}
.topbar-track span{display:inline-flex;align-items:center;gap:12px}.topbar-track i{color:var(--gold);font-size:8px}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.header{position:sticky;top:0;z-index:100;background:rgba(251,247,240,.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--line)}
.header-inner{display:flex;align-items:center;justify-content:space-between;padding:18px 24px;max-width:1280px;margin:0 auto;gap:20px}
.logo{display:flex;align-items:center;gap:12px;font-weight:700;font-size:16px;cursor:pointer}
.logo-mark{width:42px;height:42px;border-radius:12px;background:var(--grad-gold);display:grid;place-items:center;color:#fff;font-family:'Playfair Display',serif;font-weight:700;font-size:20px;box-shadow:0 6px 16px rgba(201,162,75,.35);flex-shrink:0}
.logo-text{display:flex;flex-direction:column;line-height:1.1}.logo-text small{font-size:10px;color:var(--muted);letter-spacing:2px;text-transform:uppercase}
.nav-links{display:flex;gap:28px;list-style:none}.nav-links a{font-size:14.5px;font-weight:500;color:var(--ink-2);cursor:pointer}
.nav-links a:hover{color:var(--gold-2)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;font-weight:600;font-size:14px;transition:all .3s;cursor:pointer;white-space:nowrap}
.btn-primary{background:var(--grad-gold);color:#fff;box-shadow:0 8px 20px rgba(201,162,75,.3)}
.btn-primary:hover{transform:translateY(-2px)}
.btn-outline{border:1.5px solid var(--ink);color:var(--ink);background:transparent}
.btn-outline:hover{background:var(--ink);color:var(--cream)}
.btn-wa{background:var(--wa);color:#fff}.btn-wa:hover{background:#1ea855}
.btn-lg{padding:16px 32px;font-size:15px}.btn-sm{padding:9px 16px;font-size:12.5px}
.header-actions{display:flex;gap:10px;align-items:center}
.burger{display:none;width:42px;height:42px;border-radius:12px;background:var(--cream-2);align-items:center;justify-content:center}
@media(max-width:1100px){.nav-links{display:none}}
@media(max-width:640px){.header-actions .btn-outline{display:none}.burger{display:flex}.logo-text span{font-size:13px}}
.mobile-menu{position:fixed;inset:0;z-index:200;background:var(--cream);padding:24px;transform:translateX(100%);transition:transform .4s;overflow-y:auto}
.mobile-menu.open{transform:translateX(0)}
.mobile-menu-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px}
.mobile-menu ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.mobile-menu ul a{display:block;padding:16px 20px;border-radius:14px;font-size:17px;font-weight:500;cursor:pointer}
.mobile-menu .btn{width:100%;justify-content:center;margin-top:12px}
.hero{padding:60px 0 80px;background:radial-gradient(circle at 15% 20%,rgba(232,213,160,.5),transparent 50%),radial-gradient(circle at 85% 80%,rgba(201,162,75,.15),transparent 50%),var(--grad-cream)}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:60px;align-items:center}
@media(max-width:960px){.hero-grid{grid-template-columns:1fr;gap:40px}}
.hero-badge{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;border-radius:999px;background:rgba(255,255,255,.7);border:1px solid var(--gold-light);font-size:13px;font-weight:600;color:var(--gold-2);margin-bottom:24px}
.hero h1{margin-bottom:20px}.hero h1 .gold{background:var(--grad-gold);-webkit-background-clip:text;background-clip:text;color:transparent;font-style:italic}
.hero-sub{font-size:17px;color:var(--muted);margin-bottom:32px;max-width:540px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:40px}
.hero-stats{display:flex;gap:32px;flex-wrap:wrap}
.hero-stat strong{display:block;font-family:'Playfair Display',serif;font-size:28px;line-height:1}
.hero-stat span{font-size:13px;color:var(--muted);margin-top:4px}
.hero-visual{position:relative;aspect-ratio:1/1;max-width:560px;margin-left:auto;width:100%}
.hero-img{width:100%;height:100%;border-radius:32px;box-shadow:var(--shadow-lg);overflow:hidden}
.hero-img img{width:100%;height:100%;object-fit:cover}
.float-card{position:absolute;background:#fff;border-radius:18px;padding:14px 18px;box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;font-size:13px;font-weight:600;animation:float 6s ease-in-out infinite;border:1px solid var(--line)}
.float-card i{width:36px;height:36px;border-radius:10px;background:var(--gold-soft);color:var(--gold-2);display:grid;place-items:center;font-size:16px}
.float-1{top:8%;left:-20px}.float-2{top:38%;right:-30px;animation-delay:1s}.float-3{bottom:12%;left:10%;animation-delay:2s}.float-4{bottom:30%;right:5%;animation-delay:.5s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.section-head{text-align:center;max-width:720px;margin:0 auto 56px}
.section-tag{display:inline-block;padding:6px 14px;border-radius:999px;background:var(--gold-soft);color:var(--gold-2);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px}
.section-head h2{margin-bottom:14px}.section-head p{color:var(--muted);font-size:16px}
.objectives{background:var(--white)}
.obj-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.obj-card{background:var(--grad-cream);border:1px solid var(--line);border-radius:var(--radius-lg);padding:32px 26px;transition:all .4s}
.obj-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.obj-num{font-family:'Playfair Display',serif;font-size:42px;font-weight:700;background:var(--grad-gold);-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:16px}
.obj-icon{width:52px;height:52px;border-radius:14px;background:#fff;color:var(--gold-2);display:grid;place-items:center;font-size:22px;margin-bottom:18px}
.obj-card h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;margin-bottom:8px;font-weight:700}.obj-card p{font-size:14px;color:var(--muted)}
.formations{background:var(--cream)}
.form-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:30px}
@media(max-width:480px){.form-grid{grid-template-columns:1fr}}
.form-card{background:#fff;border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line);transition:all .4s;display:flex;flex-direction:column}
.form-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:var(--gold-light)}
.form-img{aspect-ratio:16/10;position:relative;overflow:hidden;background:var(--gold-soft)}
.form-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.form-card:hover .form-img img{transform:scale(1.05)}
.form-num{position:absolute;top:16px;left:16px;background:rgba(255,255,255,.95);padding:7px 14px;border-radius:999px;font-size:12px;font-weight:700;color:var(--gold-2);letter-spacing:1.5px;z-index:2}
.form-cat{position:absolute;top:16px;right:16px;background:var(--ink);color:var(--gold-light);padding:7px 14px;border-radius:999px;font-size:10.5px;font-weight:700;letter-spacing:1.5px;z-index:2}
.form-body{padding:26px;flex:1;display:flex;flex-direction:column}
.form-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:19px;font-weight:700;line-height:1.35;margin-bottom:12px}
.form-desc{font-size:14px;color:var(--muted);line-height:1.65;margin-bottom:22px;flex:1;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.form-meta{display:flex;gap:16px;margin-bottom:20px;padding:14px 16px;border-radius:12px;background:var(--cream);border:1px solid var(--line);font-size:12.5px;flex-wrap:wrap}
.form-meta div{display:flex;align-items:center;gap:6px}.form-meta i{color:var(--gold)}
.form-foot{display:flex;justify-content:space-between;align-items:center;padding-top:20px;border-top:1px solid var(--line);gap:12px;flex-wrap:wrap}
.form-price-amount{font-family:'Playfair Display',serif;font-size:24px;font-weight:700;line-height:1}
.form-price-label{font-size:10.5px;color:var(--muted);font-weight:600;letter-spacing:1.5px;text-transform:uppercase;margin-top:4px}
.form-actions{display:flex;gap:8px}
.btn-enroll{padding:11px 20px;border-radius:999px;background:var(--grad-gold);color:#fff;font-size:12.5px;font-weight:700}
.btn-login{padding:11px 16px;border-radius:999px;background:var(--cream);color:var(--ink);font-size:12.5px;font-weight:600;border:1px solid var(--line)}
.btn-login:hover{background:var(--ink);color:var(--gold-light)}
.support-cta{background:var(--ink);color:var(--cream);border-radius:var(--radius-lg);padding:60px 40px;text-align:center;margin:40px auto;max-width:1200px}
.support-cta h2{color:var(--cream);margin-bottom:14px}.support-cta p{color:var(--gold-light);margin-bottom:28px;max-width:520px;margin:0 auto 28px}
.support-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.btn-cream{background:var(--cream);color:var(--ink)}.btn-cream:hover{background:var(--gold-light)}
.footer{background:var(--ink);color:var(--cream);padding:70px 0 30px}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:40px;margin-bottom:50px}
@media(max-width:800px){.footer-grid{grid-template-columns:1fr 1fr}}@media(max-width:500px){.footer-grid{grid-template-columns:1fr}}
.footer-brand p{color:rgba(251,247,240,.6);font-size:14px;margin:16px 0 20px;max-width:320px}
.footer h4{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gold-light);margin-bottom:18px}
.footer ul{list-style:none;display:flex;flex-direction:column;gap:10px}
.footer ul a{color:rgba(251,247,240,.7);font-size:14px;cursor:pointer}.footer ul a:hover{color:var(--gold-light)}
.socials{display:flex;gap:10px;margin-top:20px}
.socials a{width:38px;height:38px;border-radius:10px;background:rgba(251,247,240,.08);display:grid;place-items:center;color:var(--gold-light)}
.footer-bottom{border-top:1px solid rgba(251,247,240,.1);padding-top:24px;text-align:center;font-size:13px;color:rgba(251,247,240,.5)}
.float-support{position:fixed;bottom:24px;right:24px;z-index:90;width:60px;height:60px;border-radius:50%;background:var(--wa);color:#fff;display:grid;place-items:center;font-size:26px;box-shadow:0 10px 30px rgba(37,211,102,.4)}
.modal-overlay{position:fixed;inset:0;z-index:500;background:rgba(28,26,22,.6);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal{background:var(--cream);border-radius:var(--radius-lg);max-width:520px;width:100%;max-height:90vh;overflow-y:auto;padding:36px;position:relative}
.modal-close{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:50%;background:var(--cream-2);display:grid;place-items:center;color:var(--ink)}
.modal h2{font-size:26px;margin-bottom:8px}.modal .sub{color:var(--muted);font-size:14px;margin-bottom:24px}
.form-group{margin-bottom:16px}.form-group label{display:block;font-size:13px;font-weight:600;margin-bottom:6px}
.form-group input,.form-group select{width:100%;padding:13px 16px;border-radius:12px;border:1.5px solid var(--line);background:#fff;font-family:inherit;font-size:14.5px}
.form-group input:focus,.form-group select:focus{outline:none;border-color:var(--gold)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:500px){.form-row{grid-template-columns:1fr}}
.modal .btn{width:100%;justify-content:center;margin-top:8px}
.modal-switch{text-align:center;margin-top:18px;font-size:13.5px;color:var(--muted)}
.modal-switch a{color:var(--gold-2);font-weight:600;cursor:pointer}
.alert{padding:12px 16px;border-radius:12px;font-size:13.5px;margin-bottom:16px;display:flex;align-items:center;gap:10px}
.alert-ok{background:#E8F5E9;color:#2E7D32;border:1px solid #A5D6A7}
.alert-err{background:#FFEBEE;color:#C62828;border:1px solid #EF9A9A}
.alert-info{background:var(--gold-soft);color:var(--gold-2);border:1px solid var(--gold-light)}
.wa-box{margin-top:20px;padding:20px;border-radius:16px;background:#E8F8EE;border:1.5px dashed var(--wa);text-align:center}
.wa-box i{font-size:28px;color:var(--wa);margin-bottom:8px}.wa-box strong{display:block;font-size:14px;margin-bottom:4px;color:#128C4E}
.wa-box p{font-size:12.5px;color:#2E7D32;margin-bottom:12px}
.page{display:none}.page.active{display:block}
.dash{padding:40px 0 80px;background:var(--cream);min-height:100vh}
.dash-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;flex-wrap:wrap;gap:16px}
.dash-head h1{font-size:clamp(1.5rem,3vw,2.2rem)}.dash-head h1 span{color:var(--gold-2)}
.dash-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px;margin-bottom:32px}
.dash-stat{background:#fff;border-radius:var(--radius);padding:22px;border:1px solid var(--line)}
.dash-stat i{width:42px;height:42px;border-radius:12px;background:var(--gold-soft);color:var(--gold-2);display:grid;place-items:center;font-size:18px;margin-bottom:14px}
.dash-stat strong{display:block;font-family:'Playfair Display',serif;font-size:28px;line-height:1}
.dash-stat span{font-size:13px;color:var(--muted);margin-top:4px;display:block}
.dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:24px}@media(max-width:900px){.dash-grid{grid-template-columns:1fr}}
.dash-card{background:#fff;border-radius:var(--radius-lg);padding:28px;border:1px solid var(--line)}
.dash-card h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:17px;font-weight:700;margin-bottom:20px}
.progress{height:10px;background:var(--cream-2);border-radius:999px;overflow:hidden;margin:14px 0 8px}
.progress-bar{height:100%;background:var(--grad-gold);border-radius:999px;transition:width 1s}
.progress-text{display:flex;justify-content:space-between;font-size:13px;color:var(--muted)}
.course-enrolled{padding:18px;border-radius:14px;background:var(--cream);border:1px solid var(--line);margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:16px;cursor:pointer}
.course-enrolled:hover{border-color:var(--gold-light);background:#fff}
.course-enrolled-info{flex:1}.course-enrolled-info strong{display:block;font-size:15px;margin-bottom:4px}
.course-enrolled-info span{font-size:12.5px;color:var(--muted)}
.code-display{background:var(--ink);color:var(--gold-light);padding:20px 24px;border-radius:14px;font-family:'Courier New',monospace;font-size:22px;font-weight:700;letter-spacing:3px;text-align:center;margin:16px 0;position:relative;border:2px solid var(--gold)}
.code-display small{display:block;font-size:11px;letter-spacing:2px;color:var(--gold);margin-bottom:6px;font-weight:600}
.copy-btn{position:absolute;top:12px;right:12px;background:var(--gold);color:var(--ink);padding:6px 12px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer}
.admin{padding:30px 0 80px;background:var(--cream);min-height:100vh}
.admin-card{background:#fff;border-radius:var(--radius-lg);padding:32px;border:1px solid var(--line);margin-bottom:24px}
.admin-card h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.admin-card h3 i{color:var(--gold)}
.student-list{display:flex;flex-direction:column;gap:12px}
.student-item{background:var(--cream);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.student-info{flex:1;min-width:200px}
.student-info strong{display:block;font-size:16px;margin-bottom:4px}
.student-info span{font-size:13px;color:var(--muted);display:block}
.student-code{background:var(--ink);color:var(--gold-light);padding:8px 14px;border-radius:8px;font-family:'Courier New',monospace;font-size:14px;font-weight:700;letter-spacing:1px}
.student-actions{display:flex;gap:8px;flex-wrap:wrap}
.icon-btn{width:36px;height:36px;border-radius:10px;background:var(--cream-2);display:inline-grid;place-items:center;color:var(--ink-2);cursor:pointer;transition:all .2s}
.icon-btn:hover{background:var(--gold);color:#fff}
.icon-btn.danger:hover{background:#C62828}
.icon-btn.wa:hover{background:var(--wa)}
.empty-state{text-align:center;padding:40px 20px;color:var(--muted)}
.empty-state i{font-size:48px;margin-bottom:16px;opacity:.3}
.empty-state p{font-size:14px}
@media(max-width:700px){.student-item{flex-direction:column;align-items:flex-start}}
.toast{position:fixed;top:90px;right:24px;z-index:600;background:#fff;border-radius:14px;padding:14px 20px;box-shadow:var(--shadow-lg);border:1px solid var(--line);display:flex;align-items:center;gap:12px;transform:translateX(400px);transition:transform .4s;max-width:340px}
.toast.show{transform:translateX(0)}.toast i{color:var(--gold);font-size:20px}
.toast strong{display:block;font-size:14px}.toast span{font-size:12.5px;color:var(--muted)}
</style>
</head>
<body>

<div class="topbar"><div class="topbar-track">
  <span><i class="fas fa-circle"></i> FORMATIONS PRATIQUES</span>
  <span><i class="fas fa-circle"></i> DÉVELOPPEZ VOS COMPÉTENCES</span>
  <span><i class="fas fa-circle"></i> CRÉEZ VOTRE ACTIVITÉ</span>
  <span><i class="fas fa-circle"></i> CONSTRUISEZ VOTRE AVENIR NUMÉRIQUE</span>
</div></div>

<header class="header"><div class="header-inner">
  <a class="logo" onclick="go('home');return false;"><div class="logo-mark">F</div><div class="logo-text"><span>FORMATION BUSINESS DIGITAL</span><small>Plateforme Premium</small></div></a>
  <nav class="nav"><ul class="nav-links">
    <li><a onclick="go('home');return false;">Accueil</a></li>
    <li><a onclick="scrollTo2('formations');return false;">Nos formations</a></li>
    <li><a onclick="scrollTo2('support');return false;">Support</a></li>
  </ul></nav>
  <div class="header-actions">
    <button class="btn btn-outline" onclick="openModal('login')">SE CONNECTER</button>
    <button class="btn btn-primary" onclick="openModal('register')">S'INSCRIRE</button>
    <button class="burger" onclick="toggleMobile()"><i class="fas fa-bars"></i></button>
  </div>
</div></header>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-head"><div class="logo"><div class="logo-mark">F</div><div class="logo-text"><span>FBD</span><small>Plateforme Premium</small></div></div><button class="burger" onclick="toggleMobile()"><i class="fas fa-times"></i></button></div>
  <ul>
    <li><a onclick="go('home');toggleMobile()">Accueil</a></li>
