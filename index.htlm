<button class="float-support" onclick="scrollTo2('support')" title="Support WhatsApp"><i class="fab fa-whatsapp"></i></button>

<div class="modal-overlay" id="modalOverlay" onclick="if(event.target===this)closeModal()"><div class="modal" id="modalContent"></div></div>
<div class="toast" id="toast"><i class="fas fa-check-circle"></i><div><strong id="toastTitle"></strong><span id="toastMsg"></span></div></div>

<script>
var WA="44941364";
var BN="Formation Business Digital";
function waL(m){return"https://wa.me/"+WA+"?text="+encodeURIComponent(m)}

var C=[
{id:'ia',n:'01',c:'TECHNOLOGIE',t:'Intelligence Artificielle',p:2000,dur:'8 heures',m:19,cc:'FBD-IA-2026',img:'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&q=80',desc:"Découvrez les bases et les applications pratiques de l'intelligence artificielle."},
{id:'oratoire',n:'02',c:'COMMUNICATION',t:'Art Oratoire',p:1500,dur:'10 heures',m:25,cc:'FBD-OR-2026',img:'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&q=80',desc:"Développez votre communication, votre confiance, votre éloquence."},
{id:'business',n:'03',c:'BUSINESS',t:'Créer un Business en Ligne',p:2500,dur:'10 heures',m:6,cc:'FBD-BZ-2026',img:'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80',desc:"Apprenez à construire et développer une activité en ligne."},
{id:'produit',n:'04',c:'PRODUIT',t:'Créer un Produit Digital',p:1500,dur:'7 heures',m:5,cc:'FBD-PD-2026',img:'https://images.unsplash.com/photo-1553484771-371a605b060b?w=800&q=80',desc:"Apprenez à créer et commercialiser vos produits numériques."},
{id:'perso',n:'05',c:'DÉVELOPPEMENT',t:'Développement Personnel',p:1500,dur:'6 heures',m:5,cc:'FBD-DP-2026',img:'https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=800&q=80',desc:"Développez votre confiance, discipline et mindset."},
{id:'apps',n:'06',c:'DÉVELOPPEMENT',t:'Création d\'Applications',p:2500,dur:'12 heures',m:6,cc:'FBD-AP-2026',img:'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=800&q=80',desc:"Concevez des applications numériques modernes."},
{id:'web',n:'07',c:'DÉVELOPPEMENT',t:'Création de Site Web',p:3000,dur:'14 heures',m:7,cc:'FBD-WB-2026',img:'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=800&q=80',desc:"Créez un site web professionnel et moderne."},
{id:'entrep',n:'08',c:'ENTREPRENEURIAT',t:'Entrepreneuriat Digital',p:1500,dur:'8 heures',m:5,cc:'FBD-EN-2026',img:'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=800&q=80',desc:"Fondamentaux de l'entrepreneuriat digital."}
];

var DB={
 g:function(k,d){try{var v=localStorage.getItem('fbd_'+k);return v?JSON.parse(v):d}catch(e){return d}},
 s:function(k,v){try{localStorage.setItem('fbd_'+k,JSON.stringify(v))}catch(e){}},
 i:function(){
  if(!this.g('u')){this.s('u',[
   {id:2,n:'Admin',e:'admin@fbd.com',pw:'admin1234',ph:'+509 1111 1111',co:'ADMIN',cs:[],pg:{},si:'2026-01-01',ac:true,ad:true}
  ])}
 }
};
DB.i();

var S={u:DB.g('ses',null)};

function go(pg){
 document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active')});
 var t=document.getElementById('page-'+pg);
 if(t){t.classList.add('active');window.scrollTo({top:0,behavior:'smooth'})}
 if(pg==='dashboard')rDash();
 if(pg==='admin')rAdmin();
}
function scrollTo2(id){go('home');setTimeout(function(){var el=document.getElementById(id);if(el)el.scrollIntoView({behavior:'smooth'})},150)}
function toggleMobile(){document.getElementById('mobileMenu').classList.toggle('open')}

function rForm(){
 var g=document.getElementById('formGrid');if(!g)return;
 var h='';
 for(var i=0;i<C.length;i++){
  var c=C[i];
  h+='<article class="form-card"><div class="form-img"><img src="'+c.img+'" alt="'+c.t+'" loading="lazy"><div class="form-num">N° '+c.n+' — '+c.c+'</div><div class="form-cat">'+c.c+'</div></div><div class="form-body"><h3 class="form-title">'+c.t+'</h3><p class="form-desc">'+c.desc+'</p><div class="form-meta"><div><i class="fas fa-clock"></i> '+c.dur+'</div><div><i class="fas fa-layer-group"></i> '+c.m+' modules</div><div><i class="fas fa-key"></i> '+c.cc+'</div></div><div class="form-foot"><div><span class="form-price-amount">'+c.p.toLocaleString('fr-FR')+' G</span><span class="form-price-label">Gourdes</span></div><div class="form-actions"><button class="btn-login" onclick="openModal(\'login\',\''+c.id+'\')"><i class="fas fa-sign-in-alt"></i> CONNEXION</button><button class="btn-enroll" onclick="openModal(\'register\',\''+c.id+'\')">S\'INSCRIRE</button></div></div></div></article>';
 }
 g.innerHTML=h;
}

function rDash(){
 var u=S.u;if(!u||u.ad){go('home');return}
 document.getElementById('dashName').textContent=u.n.split(' ')[0].toUpperCase();
 var cb=document.getElementById('dashCodeBig');if(cb)cb.textContent=u.co||'EN ATTENTE';
 var wb=document.getElementById('dashWaBtn');
 if(wb){wb.href=waL("Bonjour "+BN+" ! Je suis "+u.n+" (code: "+(u.co||'en attente')+").")}
 var en=u.cs||[];
 document.getElementById('dashCount').textContent=en.length;
 var tM=0,dM=0;
 for(var i=0;i<en.length;i++){
  var cid=en[i];var c=null;
  for(var j=0;j<C.length;j++){if(C[j].id===cid){c=C[j];break}}
  if(!c)continue;tM+=c.m;dM+=(u.pg[cid]||[]).length;
 }
 var pc=tM?Math.round(dM/tM*100):0;
 document.getElementById('dashPercent').textContent=pc+'%';
 setTimeout(function(){document.getElementById('dashBar').style.width=pc+'%'},100);
 document.getElementById('dashDone').textContent=dM+' modules terminés';
 document.getElementById('dashTotal').textContent=tM+' modules au total';
 document.getElementById('dashStats').innerHTML='<div class="dash-stat"><i class="fas fa-graduation-cap"></i><strong>'+en.length+'</strong><span>Formations</span></div><div class="dash-stat"><i class="fas fa-check-circle"></i><strong>'+dM+'</strong><span>Terminés</span></div><div class="dash-stat"><i class="fas fa-hourglass-half"></i><strong>'+(tM-dM)+'</strong><span>Restants</span></div><div class="dash-stat"><i class="fas fa-chart-line"></i><strong>'+pc+'%</strong><span>Progression</span></div>';
 var cH='';
 if(en.length){
  for(var i=0;i<en.length;i++){
   var cid=en[i];var c=null;
   for(var j=0;j<C.length;j++){if(C[j].id===cid){c=C[j];break}}
   if(!c)continue;
   var dn=(u.pg[cid]||[]).length;var p=Math.round(dn/c.m*100);
   cH+='<div class="course-enrolled"><div class="course-enrolled-info"><strong>'+c.t+'</strong><span>'+c.c+' • Code: '+c.cc+' • '+dn+'/'+c.m+' modules</span><div class="progress" style="margin-top:8px"><div class="progress-bar" style="width:'+p+'%"></div></div></div></div>';
  }
 }else{cH='<p style="color:var(--muted);font-size:14px">Aucune formation inscrite.</p>'}
 document.getElementById('dashCourses').innerHTML=cH;
}

function openModal(tp,d){
 var ov=document.getElementById('modalOverlay');
 var ct=document.getElementById('modalContent');
 var h='';
 if(tp==='register'){
  var op='';for(var i=0;i<C.length;i++){var c=C[i];var sl=(d===c.id)?'selected':'';op+='<option value="'+c.id+'" '+sl+'>'+c.t+' — '+c.p.toLocaleString('fr-FR')+' G</option>'}
  h='<button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button><h2>INSCRIPTION</h2><p class="sub">Créez votre compte.</p><div id="regAlert"></div><form onsubmit="doReg(event)"><div class="form-group"><label>Nom complet</label><input type="text" id="rN" required></div><div class="form-group"><label>Numéro WhatsApp</label><input type="tel" id="rP" placeholder="+509 ..." required></div><div class="form-group"><label>Mot de passe</label><input type="password" id="rPw" required minlength="6"></div><div class="form-group"><label>Formation choisie</label><select id="rC" required><option value="">— Sélectionnez —</option>'+op+'</select></div><button type="submit" class="btn btn-primary btn-lg">S\'INSCRIRE</button></form>';
 }else if(tp==='login'){
  h='<button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button><h2>CONNEXION</h2><p class="sub">Accédez à votre espace.</p><div id="logAlert"></div><form onsubmit="doLog(event)"><div class="form-group"><label>Téléphone ou Email</label><input type="text" id="lE" required placeholder="+509... ou email@..."></div><div class="form-group"><label>Mot de passe</label><input type="password" id="lP" required></div><div class="form-group"><label>Code d\'accès</label><input type="text" id="lC" placeholder="FBD-2026-XXX" required></div><button type="submit" class="btn btn-primary btn-lg">SE CONNECTER</button></form>';
 }
 ct.innerHTML=h;ov.classList.add('open');
}
function closeModal(){document.getElementById('modalOverlay').classList.remove('open')}

function doReg(e){
 e.preventDefault();
 var nm=document.getElementById('rN').value.trim();
 var ph=document.getElementById('rP').value.trim();
 var pw=document.getElementById('rPw').value;
 var cr=document.getElementById('rC').value;
 var aB=document.getElementById('regAlert');
 
 var us=DB.g('u',[]);
 var nu={id:Date.now(),n:nm,ph:ph,pw:pw,cs:[],pg:{},co:null,si:new Date().toISOString().split('T')[0],ac:true};
 us.push(nu);DB.s('u',us);
 
 var pr=0;var cn='';
 for(var i=0;i<C.length;i++){if(C[i].id===cr){pr=C[i].p;cn=C[i].t;break}}
 
 var waMsg="🎓 NOUVELLE INSCRIPTION\n\n";
 waMsg+="👤 Nom: "+nm+"\n";
 waMsg+="📱 WhatsApp: "+ph+"\n";
 waMsg+="📚 Formation: "+cn+"\n";
 waMsg+="💰 Montant: "+pr.toLocaleString('fr-FR')+" Gourdes\n\n";
 waMsg+="⏳ En attente de validation et code d'accès.";
 
 window.open(waL(waMsg),'_blank');
 
 aB.innerHTML='<div class="alert alert-ok"><i class="fas fa-check-circle"></i> Inscription envoyée ! Vous recevrez votre code d\'accès bientôt.</div>';
 setTimeout(function(){closeModal();toast('Inscription envoyée !','WhatsApp ouvert.')},2000);
}

function doLog(e){
 e.preventDefault();
 var em=document.getElementById('lE').value.trim().toLowerCase();
 var pw=document.getElementById('lP').value;
 var co=document.getElementById('lC').value.trim().toUpperCase();
 var aB=document.getElementById('logAlert');
 var us=DB.g('u',[]);var u=null;
 for(var i=0;i<us.length;i++){
  if((us[i].e===em||us[i].ph===em)&&us[i].pw===pw){u=us[i];break}
 }
 if(!u){aB.innerHTML='<div class="alert alert-err"><i class="fas fa-exclamation-circle"></i> Informations incorrectes.</div>';return}
 if(!u.ad&&u.co!==co){aB.innerHTML='<div class="alert alert-err"><i class="fas fa-exclamation-circle"></i> Code invalide.</div>';return}
 if(!u.ac){aB.innerHTML='<div class="alert alert-err"><i class="fas fa-exclamation-circle"></i> Compte désactivé.</div>';return}
 S.u=u;DB.s('ses',u);closeModal();
 toast('Bienvenue !','Connexion réussie');
 setTimeout(function(){if(u.ad)go('admin');else go('dashboard')},500);
}

function logout(){S.u=null;DB.s('ses',null);go('home');toast('Déconnexion','À bientôt !')}

function rAdmin(){
 var u=S.u;if(!u||!u.ad){go('home');return}
 var us=DB.g('u',[]).filter(function(x){return !x.ad});
 
 var sel=document.getElementById('aC');
 if(sel&&sel.options.length<=1){
  for(var i=0;i<C.length;i++){
   var opt=document.createElement('option');
   opt.value=C[i].id;
   opt.textContent=C[i].t+' — '+C[i].p.toLocaleString('fr-FR')+' G';
   sel.appendChild(opt);
  }
 }
 
 var sH='';
 if(us.length===0){
  sH='<div class="empty-state"><i class="fas fa-users"></i><p>Aucun étudiant enregistré.<br>Ajoutez votre premier étudiant ci-dessus.</p></div>';
 }else{
  for(var i=0;i<us.length;i++){
   var x=us[i];
   var cn='Aucune formation';
   if(x.cs&&x.cs.length>0){
    var cns=[];
    for(var j=0;j<x.cs.length;j++){
     for(var k=0;k<C.length;k++){
      if(C[k].id===x.cs[j]){cns.push(C[k].t);break}
     }
    }
    cn=cns.join(', ');
   }
   
   var waMsg="🎓 BIENVENUE !\n\n";
   waMsg+="Bonjour "+x.n+" !\n\n";
   waMsg+="Votre inscription a été validée.\n\n";
   waMsg+="🔑 Code d'accès: "+(x.co||'En attente')+"\n";
   waMsg+="📚 Formation: "+cn+"\n\n";
   waMsg+="Connectez-vous sur: "+window.location.origin+"\n\n";
   waMsg+="📱 Pour vous connecter:\n";
   waMsg+="1. Allez sur le site\n";
   waMsg+="2. Cliquez sur SE CONNECTER\n";
   waMsg+="3. Entrez: "+x.ph+"\n";
   waMsg+="4. Entrez votre mot de passe\n";
   waMsg+="5. Entrez le code: "+(x.co||'En attente');
   
   sH+='<div class="student-item">';
   sH+='<div class="student-info">';
   sH+='<strong>'+x.n+'</strong>';
   sH+='<span><i class="fas fa-phone"></i> '+x.ph+'</span>';
   sH+='<span><i class="fas fa-book"></i> '+cn+'</span>';
   sH+='</div>';
   sH+='<div class="student-code">'+(x.co||'—')+'</div>';
   sH+='<div class="student-actions">';
   sH+='<a href="'+waL(waMsg)+'" target="_blank" class="icon-btn wa" title="Envoyer code WhatsApp"><i class="fab fa-whatsapp"></i></a>';
   sH+='<button class="icon-btn danger" onclick="adDU('+x.id+')" title="Supprimer"><i class="fas fa-trash"></i></button>';
   sH+='</div>';
   sH+='</div>';
  }
 }
 document.getElementById('adminStudents').innerHTML=sH;
}

function adSt(e){
 e.preventDefault();
 var nm=document.getElementById('aN').value.trim();
 var ph=document.getElementById('aP').value.trim();
 var em=document.getElementById('aE').value.trim();
 var cr=document.getElementById('aC').value;
 var pw=document.getElementById('aPw').value;
 
 var us=DB.g('u',[]);
 var cd=DB.g('cd',[]);
 var nm2=cd.length+1;
 var co='FBD-2026-'+(nm2<10?'00':nm2<100?'0':'')+nm2;
 
 var nu={id:Date.now(),n:nm,e:em,ph:ph,pw:pw,cs:[cr],pg:{},co:co,si:new Date().toISOString().split('T')[0],ac:true};
 us.push(nu);DB.s('u',us);
 
 cd.push({id:Date.now(),co:co,uid:nu.id,cid:cr,ac:true});
 DB.s('cd',cd);
 
 var cn='';
 for(var i=0;i<C.length;i++){if(C[i].id===cr){cn=C[i].t;break}}
 
 var waMsg="🎓 BIENVENUE !\n\n";
 waMsg+="Bonjour "+nm+" !\n\n";
 waMsg+="Votre inscription a été validée.\n\n";
 waMsg+="🔑 Code d'accès: "+co+"\n";
 waMsg+="📚 Formation: "+cn+"\n";
 waMsg+="💰 Montant: "+C.find(function(c){return c.id===cr}).p.toLocaleString('fr-FR')+" Gourdes\n\n";
 waMsg+="Connectez-vous sur: "+window.location.origin+"\n\n";
 waMsg+="📱 Pour vous connecter:\n";
 waMsg+="1. Allez sur le site\n";
 waMsg+="2. Cliquez sur SE CONNECTER\n";
 waMsg+="3. Entrez: "+ph+"\n";
 waMsg+="4. Entrez votre mot de passe\n";
 waMsg+="5. Entrez le code: "+co+"\n\n";
 waMsg+="À bientôt !";
 
 window.open(waL(waMsg),'_blank');
 
 toast('Étudiant ajouté !','Code: '+co+' envoyé sur WhatsApp.');
 
 document.getElementById('aN').value='';
 document.getElementById('aP').value='';
 document.getElementById('aE').value='';
 document.getElementById('aPw').value='';
 
 rAdmin();
}

function adDU(id){
 if(!confirm('Supprimer cet étudiant ?'))return;
 var us=DB.g('u',[]).filter(function(x){return x.id!==id});
 DB.s('u',us);
 rAdmin();
 toast('Supprimé !','Étudiant retiré.');
}

function copyCode(id){
 var el=document.getElementById(id);
 var t=el.textContent;
 if(navigator.clipboard){
  navigator.clipboard.writeText(t).then(function(){toast('Copié !','Code: '+t)});
 }
}

function toast(t,m){
 document.getElementById('toastTitle').textContent=t;
 document.getElementById('toastMsg').textContent=m;
 var x=document.getElementById('toast');
 x.classList.add('show');
 setTimeout(function(){x.classList.remove('show')},3500);
}

document.addEventListener('DOMContentLoaded',function(){
 try{
  var ws=document.getElementById('waSupportLink');if(ws)ws.href=waL("Bonjour "+BN+" !");
  var fw=document.getElementById('footerWa');if(fw)fw.href=waL("Bonjour "+BN+" !");
  rForm();
  if(S.u){if(S.u.ad)go('admin');else go('dashboard')}
 }catch(e){console.error(e)}
});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal()});
</script>
</body>
</html>
