      <button class="btn btn-outline" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Déconnexion</button>
    </div>
    <div class="dash-card" style="margin-bottom:24px;background:var(--ink);color:var(--cream);border:none">
      <h3 style="color:var(--gold-light)"><i class="fas fa-key" style="color:var(--gold)"></i> VOTRE CODE D'ACCÈS</h3>
      <p style="color:rgba(251,247,240,.7);font-size:13px;margin-bottom:8px">Conservez ce code précieusement.</p>
      <div class="code-display"><small>CODE ÉTUDIANT</small><span id="dashCodeBig">—</span><button class="copy-btn" onclick="copyCode('dashCodeBig')"><i class="fas fa-copy"></i> COPIER</button></div>
      <div style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap"><a href="#" id="dashWaBtn" target="_blank" class="btn btn-wa btn-sm"><i class="fab fa-whatsapp"></i> CONTACTER VIA WHATSAPP</a></div>
    </div>
    <div class="dash-stats" id="dashStats"></div>
    <div class="dash-grid">
      <div class="dash-card"><h3>MES FORMATIONS <span id="dashCount" style="background:var(--gold-soft);color:var(--gold-2);padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700">0</span></h3><div id="dashCourses"></div></div>
      <div class="dash-card">
        <h3>PROGRESSION GLOBALE</h3>
        <div style="text-align:center;padding:20px 0"><div style="font-family:'Playfair Display',serif;font-size:56px;font-weight:700;background:var(--grad-gold);-webkit-background-clip:text;background-clip:text;color:transparent" id="dashPercent">0%</div></div>
        <div class="progress"><div class="progress-bar" id="dashBar" style="width:0%"></div></div>
        <div class="progress-text"><span id="dashDone">0 modules</span><span id="dashTotal">0 modules</span></div>
      </div>
    </div>
  </div></section>
</div>

<div class="page" id="page-admin">
