    <div class="dash-head">
      <div><h1>ESPACE <span>ADMINISTRATEUR</span></h1><p style="color:var(--muted);margin-top:6px">Gérez vos étudiants et codes d'accès.</p></div>
      <button class="btn btn-outline" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Déconnexion</button>
    </div>
    
    <div class="admin-card">
      <h3><i class="fas fa-user-plus"></i> AJOUTER UN ÉTUDIANT</h3>
      <form onsubmit="adSt(event)">
        <div class="form-row">
          <div class="form-group">
            <label>Nom complet *</label>
            <input type="text" id="aN" required placeholder="Ex: Jean Pierre">
          </div>
          <div class="form-group">
            <label>Téléphone WhatsApp *</label>
            <input type="tel" id="aP" required placeholder="+509 0000 0000">
          </div>
        </div>
        <div class="form-group">
          <label>Email (optionnel)</label>
          <input type="email" id="aE" placeholder="email@exemple.com">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Formation *</label>
            <select id="aC" required>
              <option value="">— Sélectionnez —</option>
            </select>
          </div>
          <div class="form-group">
            <label>Mot de passe *</label>
            <input type="text" id="aPw" required placeholder="Mot de passe">
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-plus"></i> AJOUTER L'ÉTUDIANT</button>
      </form>
    </div>

    <div class="admin-card">
      <h3><i class="fas fa-users"></i> LISTE DES ÉTUDIANTS</h3>
      <div class="student-list" id="adminStudents"></div>
    </div>
  </div></section>
